#!/bin/sh
# w202-wcn-reopen: reopen Wi-Fi when sprd_wlan_combo's recovery watchdog asks (w202-wcn-reopen.service, started by
# 70-w202-wcn.rules on its FW_ERROR uevent after a WCN chip reset, or TX_STALL when the data TX stalled). Based on
# mu300-linux's wcn-reopen. The chip's Wi-Fi stays off (or stalled) until every interface of phy0 has closed and one
# opens again. A down/up of wlan0 alone is not that here: the P2P device wpa_supplicant keeps open holds the chip, so
# it never restarted. Soft-blocking the radio closes them all (cfg80211 shuts down every interface, the P2P device
# too); after the unblock NetworkManager opens wlan0 again and connects.
# NetworkManager has to get the interface back from wpa_supplicant as well: when the firmware asserted while it did
# that (a TX_STALL reopen can do that; the FW_ERROR that follows joins this run), its link-up failed and it left wlan0
# "unavailable" for good. So the reopen is checked, and done again until NetworkManager has wlan0 (three times; each
# waits 20 s, enough for the card dump and the chip reset in between).
# The recovery watchdog counts Wi-Fi stuck until a power-on has succeeded, wlan0 up or not, so a down interface goes
# up once and back down, and a blocked radio is unblocked for that moment. If Wi-Fi does not come back, the watchdog
# still reboots (sprd_wlan_combo.recovery_reboot).
# Bluetooth is stopped first and started again last: a chip reset leaves it dead (its HCI commands time out), and
# with Bluetooth off the chip powers off while Wi-Fi is closed, so Wi-Fi starts cold, from a freshly loaded firmware
# (a warm restart on the stalled firmware could assert).
IFACE=wlan0
[ -e /sys/class/net/$IFACE ] || exit 0
bt=0
if systemctl -q is-active w202-bluetooth.service; then
    bt=1
    systemctl stop w202-bluetooth.service
fi
trap '[ $bt = 1 ] && systemctl --no-block start w202-bluetooth.service' EXIT
SOFT=$(echo /sys/class/net/$IFACE/phy80211/rfkill*/soft)
up() { ip link show $IFACE | grep -q '[<,]UP[,>]'; }
# NetworkManager has the interface (wpa_supplicant attached): any state past "unavailable" (20)
nm_has_it() {
    state=$(nmcli -g GENERAL.STATE device show $IFACE 2>/dev/null) || return 0   # NetworkManager not running
    [ "${state%% *}" -gt 20 ] 2>/dev/null
}
cycle() {
    echo 1 > "$SOFT"
    sleep 1
    echo 0 > "$SOFT"
}
was_up=0
up && was_up=1
was_blocked=$(cat "$SOFT")
echo "reopening $IFACE (it was $([ $was_up = 1 ] && echo up || echo down)$([ "$was_blocked" = 1 ] && echo ', radio blocked'))"
if [ $was_up = 0 ]; then
    cycle
    ip link set $IFACE up
    ip link set $IFACE down
    [ "$was_blocked" = 1 ] && echo 1 > "$SOFT"
    exit 0
fi
for attempt in 1 2 3; do
    cycle
    for _ in $(seq 1 40); do
        up && nm_has_it && { echo "$IFACE is back (attempt $attempt)"; exit 0; }
        sleep 0.5
    done
    echo "attempt $attempt: $IFACE $(up && echo up || echo down), NetworkManager state '$(nmcli -g GENERAL.STATE device show $IFACE 2>/dev/null)'"
done
# NetworkManager never took it back: at least power the chip on, so the watchdog does not reboot for nothing
up || ip link set $IFACE up
exit 0
