#!/bin/sh
# Bring up the SC2355 (Marlin3) Bluetooth controller of the W200DS for BlueZ.
# sprdbt_tty exposes the controller as an H4 tty (/dev/ttyBT0) over the WCN PCIe link;
# w202-bt-init uploads the vendor PSKey/RF blocks (from Android's /odm/firmware) and
# btattach keeps the hci_uart line discipline attached while the service runs.
set -e
FW=/usr/lib/firmware
STATE=/var/lib/w202ds/bdaddr

grep -q "^wcn_bsp " /proc/modules || modprobe wcn_bsp
grep -q "^sprdbt_tty " /proc/modules || modprobe sprdbt_tty
for n in $(seq 1 10); do [ -c /dev/ttyBT0 ] && break; sleep 1; done
[ -c /dev/ttyBT0 ] || { echo "no /dev/ttyBT0" >&2; exit 1; }

# factory address from prodnv (/mnt/vendor/btmac.txt on Android), cached after first read
if [ ! -s "$STATE" ]; then
    mkdir -p "${STATE%/*}"
    T=$(mktemp -d)
    if mount -o ro,noload /dev/disk/by-partlabel/prodnv "$T" 2>/dev/null; then
        sed -n '1s/^\([0-9A-Fa-f:]\{17\}\).*/\1/p' "$T/btmac.txt" > "$STATE" || true
        umount "$T"
    fi
    rmdir "$T"
fi
BDADDR=$(cat "$STATE" 2>/dev/null || true)
case "$BDADDR" in
    ??:??:??:??:??:??) ;;
    *)  h=$(printf 'w202-bt-%s' "$(cat /etc/machine-id)" | sha256sum | cut -c1-12)
        first=$(( (0x$(echo "$h" | cut -c1-2) | 0x02) & 0xfe ))
        BDADDR=$(printf '%02x:%s:%s:%s:%s:%s' "$first" "$(echo "$h" | cut -c3-4)" "$(echo "$h" | cut -c5-6)" \
            "$(echo "$h" | cut -c7-8)" "$(echo "$h" | cut -c9-10)" "$(echo "$h" | cut -c11-12)")
        echo "$BDADDR" > "$STATE" ;;
esac

# power-cycle the BT function so the controller starts from its ROM defaults
rfkill block bluetooth || true
sleep 1
rfkill unblock bluetooth
sleep 2
/usr/local/sbin/w202-bt-init -d /dev/ttyBT0 -p "$FW/bt_configure_pskey.ini" -r "$FW/bt_configure_rf.ini" -a "$BDADDR"
exec btattach -B /dev/ttyBT0 -P h4
