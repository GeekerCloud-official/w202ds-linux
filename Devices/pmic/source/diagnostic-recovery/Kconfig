config W202DS_DIAG_RECOVERY
	bool "W202DS UMP9620 diagnostic recovery control"
	depends on ARM64 && ARCH_SPRD
	help
	  Keep /dev/w202diagctl cancel/rearm ioctls and the explicit emergency
	  fastboot fallback. This is a diagnostic policy, not a hardware watchdog.

config W202DS_DIAG_BOOT_TIMEOUT
	int "Initial diagnostic recovery timeout (seconds, zero disables)"
	depends on W202DS_DIAG_RECOVERY
	range 0 600
	default 0
	help
	  Normal configurations leave this at zero. The imported diagnostic
	  Server profile explicitly retains 120 seconds and userspace cancellation.
