#!/bin/sh
# Early-userspace startup for the flat module layout in the W202DS boot image.
set -eu
STATE=/sys/bus/platform/devices/zsk_keyboard/state
LOCK=/run/w202-keyboard-start.lock
if ! mkdir "$LOCK" 2>/dev/null; then
 echo W202_KEYBOARD_START_IN_PROGRESS
 exit 0
fi
trap 'rmdir "$LOCK"' EXIT
if [ -r "$STATE" ] && grep -q '^uart_open=1' "$STATE"; then
 echo W202_KEYBOARD_ALREADY_ATTACHED
 exit 0
fi
if ! grep -q '^w202_zsk ' /proc/modules; then
 insmod /lib/modules/w202_zsk.ko
fi
n=0
while [ ! -r "$STATE" ] && [ "$n" -lt 20 ]; do
 sleep 0.1
 n=$((n+1))
done
test -r "$STATE"
setsid /bin/w202-keyboard-attach /dev/ttyS2 </dev/null >/run/w202-keyboard.log 2>&1 &
attach_pid=$!
echo "$attach_pid" >/run/w202-keyboard.pid
n=0
while ! grep -q '^uart_open=1' "$STATE" && [ "$n" -lt 30 ]; do
 kill -0 "$attach_pid"
 sleep 0.1
 n=$((n+1))
done
kill -0 "$attach_pid"
grep -q '^uart_open=1' "$STATE"
echo W202_KEYBOARD_READY
