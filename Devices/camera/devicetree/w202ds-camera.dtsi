// W202DS imported hardware layout; driver status is documented in ../README.md.
/ {
	aliases {
		cooling-device0 = "/cooling-devices/cluster0-cooling";
		cooling-device1 = "/cooling-devices/cluster1-cooling";
		cooling-device2 = "/cooling-devices/cluster2-cooling";
	};
	soc {
		ap-ahb {
			i2c@2240000 {
				sensor-main@20 {
					compatible = "sprd,sensor-main";
					reg = <0x20>;
					clock-names = "clk_src", "sensor_eb", "clk_96m", "clk_64m", "clk_51m2", "clk_48m", "clk_26m";
					clocks = <0x19 0x19 0x1a 0x27 0x0b 0x08 0x0b 0x06 0x0b 0x05 0x0b 0x04 0x09>;
					vddio-supply = <0x1b>;
					vddcama-supply = <0x1c>;
					vddcamd-supply = <0x1d>;
					vddcammot-supply = <0x1e>;
					reset-gpios = <0x0c 0x28 0x00>;
					sprd,phyid = <0x02>;
					csi = <0x1f>;
					power-domains = <0x20>;
					phandle = <0x148>;
				};
			};
			i2c@2250000 {
				sensor-sub@5a {
					compatible = "sprd,sensor-sub";
					reg = <0x5a>;
					clock-names = "clk_src", "sensor_eb", "clk_96m", "clk_64m", "clk_51m2", "clk_48m", "clk_26m";
					clocks = <0x19 0x1c 0x1a 0x2a 0x0b 0x08 0x0b 0x06 0x0b 0x05 0x0b 0x04 0x09>;
					vddio-supply = <0x1b>;
					vddcama-supply = <0x21>;
					vddcamd-supply = <0x22>;
					reset-gpios = <0x0c 0x27 0x00>;
					sprd,phyid = <0x03>;
					csi = <0x23>;
					power-domains = <0x20>;
					phandle = <0x14a>;
				};
			};
			i2c@2280000 {
				sensor-main2@5a {
					compatible = "sprd,sensor-main2";
					reg = <0x5a>;
					clock-names = "clk_src", "sensor_eb", "clk_96m", "clk_64m", "clk_51m2", "clk_48m", "clk_26m";
					clocks = <0x19 0x1a 0x1a 0x28 0x0b 0x08 0x0b 0x06 0x0b 0x05 0x0b 0x04 0x09>;
					vddio-supply = <0x1b>;
					vddcama-supply = <0x29>;
					vddcamd-supply = <0x2a>;
					reset-gpios = <0x0c 0x29 0x00>;
					sprd,phyid = <0x01>;
					csi = <0x2b>;
					power-domains = <0x20>;
					phandle = <0x14f>;
				};
			};
			i2c@22a0000 {
				flash-ic@63 {
					compatible = "sprd,flash-aw36518a_gpio";
					reg = <0x63>;
					sprd,flash-ic = <0x8ea6>;
					sprd,torch = <0x01>;
					sprd,preflash = <0x01>;
					sprd,highlight = <0x01>;
					sprd,torch-level = <0x0a>;
					sprd,preflash-level = <0x0a>;
					sprd,highlight-level = <0x0f>;
					sprd,lvfm-enable = <0x01>;
					flash-torch-en-gpios = <0x0c 0x6f 0x00>;
					phandle = <0x153>;
				};
			};
		};
		mm {
			mm_domain {
				compatible = "sprd,qogirn6pro-camsys-domain";
				force_shutdown = <0x04 0x2e8 0x2000000>;
				shutdown_en = <0x04 0x2e8 0x1000000>;
				camera_power_state = <0x04 0x508 0x1f000000>;
				isp_force_shutdown = <0x04 0x2f4 0x2000000>;
				isp_shutdown_en = <0x04 0x2f4 0x1000000>;
				isp_power_state = <0x04 0x50c 0x1f0000>;
