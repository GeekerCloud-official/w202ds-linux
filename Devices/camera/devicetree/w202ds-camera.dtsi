				clocks = <0x11 0x07 0x1a 0x01 0x1a 0x08 0x19 0x16 0x1a 0x0f 0x1a 0x05 0x1a 0x06 0x0b 0x0a 0x0b 0x0f 0x19 0x18 0x0b 0x09>;
