				dcam_shutdown_en = <0x04 0x2ec 0x1000000>;
				dcam_power_state = <0x04 0x50c 0x1f>;
				aon_apb_mm_eb = <0x02 0x00 0x200>;
				mm_ahb_dvfs_en = <0x40 0x00 0x08>;
				cam_sw_dvfs_ack = <0x41 0x38 0x100>;
