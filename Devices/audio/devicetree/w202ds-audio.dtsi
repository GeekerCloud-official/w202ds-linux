// W202DS Server hardware layout; split from the validated imported tree.
/ {
	soc {
		ap-ahb {
			i2s@0x202b0000 {
				compatible = "sprd,i2s";
				reg = <0x00 0x202b0000 0x00 0x1000>;
				sprd,dai_name = "i2s_bt_sco0";
				sprd,hw_port = <0x00>;
				sprd,syscon-ap-apb = <0x15>;
				#sound-dai-cells = <0x00>;
				status = "disable";
				clock-names = "clk_iis0";
				clocks = <0x08 0x11>;
				sprd,config_type = "pcm";
				sprd,slave_timeout = <0xf11>;
				sprd,fs = <0x1f40>;
				sprd,bus_type = <0x01>;
				sprd,rtx_mode = <0x03>;
				sprd,byte_per_chan = <0x01>;
				sprd,slave_mode = <0x00>;
				sprd,lsb = <0x00>;
				sprd,lrck = <0x00>;
				sprd,low_for_left = <0x01>;
				sprd,clk_inv = <0x00>;
				sprd,pcm_short_frame = <0x01>;
				sprd,pcm_slot = <0x01>;
				sprd,pcm_cycle = <0x01>;
				sprd,tx_watermark = <0x0c>;
				sprd,rx_watermark = <0x14>;
				phandle = <0x143>;
			};
			i2c@22c0000 {
				aw883xx_smartpa@34 {
					status = "okay";
					compatible = "awinic,aw883xx_smartpa";
					#sound-dai-cells = <0x01>;
					reg = <0x34>;
					reset-gpio = <0x0c 0x3d 0x00>;
					sync-load = <0x01>;
					sound-channel = <0x00>;
					phandle = <0x10f>;
				};
				aw883xx_smartpa@35 {
					status = "okay";
					compatible = "awinic,aw883xx_smartpa";
					#sound-dai-cells = <0x01>;
					reg = <0x35>;
					sync-load = <0x01>;
					sound-channel = <0x01>;
					phandle = <0x110>;
				};
				aw883xx_smartpa@36 {
					status = "okay";
					compatible = "awinic,aw883xx_smartpa";
					#sound-dai-cells = <0x01>;
					reg = <0x36>;
					sync-load = <0x01>;
					sound-channel = <0x02>;
					phandle = <0x111>;
				};
				aw883xx_smartpa@37 {
