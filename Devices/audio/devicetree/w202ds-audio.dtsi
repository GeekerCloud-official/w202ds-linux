			audio-codec@56360000 {
				compatible = "unisoc,audio-codec-dig-agcp";
				reg = <0x00 0x56360000 0x00 0x800>;
				sprd,syscon-agcp-ahb = <0x9a>;
				phandle = <0x7f>;
