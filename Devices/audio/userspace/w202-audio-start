#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# Boot-time speaker bring-up. Do not unbind/rebind the built-in audio clocks.
set -eu
case "$(uname -r)" in
    6.18.35-w202ds-audio1|6.18.35-w202ds-g102e847e2492) ;;
    *) echo 'W202DS audio: install modules for this kernel first' >&2; exit 1 ;;
esac
/sbin/modprobe unisoc_mailbox
/sbin/modprobe w202_audio_amp
/sbin/modprobe w202_audio_dsp
attempt=0
while ! test -L /sys/bus/platform/devices/56200000.clock-controller/driver; do
    attempt=$((attempt + 1))
    test "$attempt" -le 50 || {
        echo 'W202DS audio: audio clocks unavailable; reboot with audio enabled' >&2
        exit 1
    }
    sleep 0.1
done
/sbin/modprobe sprd_dma
/sbin/modprobe snd_soc_aw88166
/sbin/modprobe w202_audio_vbc
/sbin/modprobe w202_audio_pcm
/sbin/modprobe w202_audio_card
test -c /dev/snd/controlC0
test -c /dev/snd/pcmC0D0p
echo 'W202DS speaker card ready'
