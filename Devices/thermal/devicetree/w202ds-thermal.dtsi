				sensor@6 {
					reg = <0x06>;
					nvmem-cells = <0x92>;
					nvmem-cell-names = "sen_delta_cal";
				};
			};
			thermal@2A0000 {
				compatible = "sprd,thermal_r5p0";
				reg = <0x2a0000 0x10000>;
				clock-names = "enable";
				clocks = <0x11 0x2a>;
				#thermal-sensor-cells = <0x01>;
				nvmem-cells = <0x93>;
				nvmem-cell-names = "thm_ratio_cal";
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				phandle = <0x122>;
				sensor@0 {
					reg = <0x00>;
					nvmem-cells = <0x94>;
					nvmem-cell-names = "sen_delta_cal";
				};
				sensor@1 {
					reg = <0x01>;
					nvmem-cells = <0x95>;
					nvmem-cell-names = "sen_delta_cal";
				};
				sensor@2 {
					reg = <0x02>;
					nvmem-cells = <0x96>;
					nvmem-cell-names = "sen_delta_cal";
				};
				sensor@3 {
					reg = <0x03>;
					nvmem-cells = <0x97>;
					nvmem-cell-names = "sen_delta_cal";
				};
				sensor@4 {
					reg = <0x04>;
					nvmem-cells = <0x98>;
					nvmem-cell-names = "sen_delta_cal";
				};
				sensor@5 {
					reg = <0x05>;
					nvmem-cells = <0x99>;
					nvmem-cell-names = "sen_delta_cal";
				};
			};
		};
	};
