// W202DS Server hardware layout; split from the validated imported tree.
/ {
	chg-sensor {
		phandle = <0x23d>;
		temperature-lookup-table = <0xffff64c2 0x46b 0xffff8baf 0x456 0xffffb3e8 0x432 0xffffedb9 0x3d7 0x277e 0x346 0x60e5 0x28e 0xaf7a 0x19d 0xd677 0x13c 0xfd7f 0xee 0x12484 0xb2 0x14b93 0x85 0x172a3 0x64 0x199b0 0x4b 0x1c0c9 0x39 0x1e7c8 0x2b>;
		io-channel-names = "sensor-channel";
		io-channels = <0x75 0x04>;
		#thermal-sensor-cells = <0x00>;
		compatible = "generic-adc-thermal";
	};
	nr-sensor {
		phandle = <0x23c>;
		temperature-lookup-table = <0xffff64c2 0x46b 0xffff8baf 0x456 0xffffb3e8 0x432 0xffffedb9 0x3d7 0x277e 0x346 0x60e5 0x28e 0xaf7a 0x19d 0xd677 0x13c 0xfd7f 0xee 0x12484 0xb2 0x14b93 0x85 0x172a3 0x64 0x199b0 0x4b 0x1c0c9 0x39 0x1e7c8 0x2b>;
		io-channel-names = "sensor-channel";
		io-channels = <0x75 0x03>;
		#thermal-sensor-cells = <0x00>;
		compatible = "generic-adc-thermal";
	};
	pa-sensor {
		phandle = <0x23b>;
		temperature-lookup-table = <0xffff64c2 0x46b 0xffff8baf 0x456 0xffffb3e8 0x432 0xffffedb9 0x3d7 0x277e 0x346 0x60e5 0x28e 0xaf7a 0x19d 0xd677 0x13c 0xfd7f 0xee 0x12484 0xb2 0x14b93 0x85 0x172a3 0x64 0x199b0 0x4b 0x1c0c9 0x39 0x1e7c8 0x2b>;
		io-channel-names = "sensor-channel";
		io-channels = <0x75 0x02>;
		#thermal-sensor-cells = <0x00>;
		compatible = "generic-adc-thermal";
	};
	thermal-sensor {
		phandle = <0x23a>;
		temperature-lookup-table = <0xffff64c2 0x46b 0xffff8baf 0x456 0xffffb3e8 0x432 0xffffedb9 0x3d7 0x277e 0x346 0x60e5 0x28e 0xaf7a 0x19d 0xd677 0x13c 0xfd7f 0xee 0x12484 0xb2 0x14b93 0x85 0x172a3 0x64 0x199b0 0x4b 0x1c0c9 0x39 0x1e7c8 0x2b>;
		io-channel-names = "sensor-channel";
		io-channels = <0x75 0x01>;
		#thermal-sensor-cells = <0x00>;
		compatible = "generic-adc-thermal";
	};
	aliases {
		thm-sensor0 = "/virtual-sensor@0";
	};
	soc {
		aon {
			thermal@270000 {
				compatible = "sprd,thermal_r5p0";
				reg = <0x270000 0x10000>;
				clock-names = "enable";
				clocks = <0x11 0x27>;
				#thermal-sensor-cells = <0x01>;
				nvmem-cells = <0x83>;
				nvmem-cell-names = "thm_ratio_cal";
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				phandle = <0x11f>;
				sensor@0 {
					reg = <0x00>;
					nvmem-cells = <0x84>;
					nvmem-cell-names = "sen_delta_cal";
				};
				sensor@1 {
					reg = <0x01>;
					nvmem-cells = <0x85>;
					nvmem-cell-names = "sen_delta_cal";
				};
			};
			thermal@280000 {
				compatible = "sprd,thermal_r5p0";
				reg = <0x280000 0x10000>;
				clock-names = "enable";
				clocks = <0x11 0x28>;
				#thermal-sensor-cells = <0x01>;
				nvmem-cells = <0x86>;
				nvmem-cell-names = "thm_ratio_cal";
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				phandle = <0x120>;
				sensor@0 {
					reg = <0x00>;
					nvmem-cells = <0x87>;
					nvmem-cell-names = "sen_delta_cal";
				};
				sensor@1 {
