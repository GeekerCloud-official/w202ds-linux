					nvmem-cell-names = "sen_delta_cal";
				};
				sensor@3 {
					reg = <0x03>;
					nvmem-cells = <0x8a>;
					nvmem-cell-names = "sen_delta_cal";
				};
			};
			thermal@290000 {
				compatible = "sprd,thermal_r5p0";
				reg = <0x290000 0x10000>;
				clock-names = "enable";
				clocks = <0x11 0x29>;
				#thermal-sensor-cells = <0x01>;
				nvmem-cells = <0x8b>;
				nvmem-cell-names = "thm_ratio_cal";
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				phandle = <0x121>;
				sensor@0 {
					reg = <0x00>;
					nvmem-cells = <0x8c>;
					nvmem-cell-names = "sen_delta_cal";
				};
				sensor@1 {
					reg = <0x01>;
