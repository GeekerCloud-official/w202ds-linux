// W202DS Server hardware layout; split from the validated imported tree.
/ {
	soc {
		ap-ahb {
			i2c@2260000 {
				charger2@6b {
					compatible = "ti,bq2560x_chg2";
					reg = <0x6b>;
					phys = <0x24>;
					monitored-battery = <0x25 0x26>;
					extcon = <0x27>;
					enable-gpios = <0x0c 0xbb 0x00>;
					vindpm-value = <0x10ae>;
					use-pfm-mode;
					role-slave;
					phandle = <0x14c>;
				};
			};
			i2c@22a0000 {
				charger@6b {
					compatible = "ti,bq2560x_chg";
					reg = <0x6b>;
					phys = <0x24>;
					monitored-battery = <0x25 0x26>;
					extcon = <0x2c>;
					vindpm-value = <0x10ae>;
					host-status-check;
					use-pfm-mode;
					use-typec-extcon;
					driver-icl-vote;
					phandle = <0x152>;
					otg-vbus {
						regulator-name = "vddvbus";
						phandle = <0x7a>;
					};
				};
			};
		};
	};
