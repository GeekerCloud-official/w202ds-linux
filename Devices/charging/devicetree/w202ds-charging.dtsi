		zte-cm-fuel-gauge = "zte-fgu";
		monitored-battery = <0x25 0x26>;
	};
	charger_policy_service {
		compatible = "zte,charger-policy-service";
		status = "okay";
		policy,enable = <0x01>;
		policy,retry-times = <0x0a>;
		policy,expired-mode-enable = <0x01>;
