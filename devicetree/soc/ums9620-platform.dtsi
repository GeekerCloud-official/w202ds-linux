				};
				nfc@8 {
					compatible = "st,st21nfc";
					reg = <0x08>;
					interrupt-parent = <0x0c>;
					interrupts = <0x09 0x00>;
					irq-gpios = <0x0c 0x7f 0x00>;
					reset-gpios = <0x0c 0x96 0x00>;
					clkreq-gpios = <0x0c 0x93 0x00>;
					interrupt-names = "nfc_int";
					clock-names = "clk_aux1", "ext_26m", "aux1_eb";
					clocks = <0x11 0x6c 0x28 0x00 0x11 0x04>;
				};
			};
			i2c@2270000 {
				compatible = "sprd,qogirn6pro-i2c", "sprd,sc9860-i2c";
				reg = <0x2270000 0x100>;
