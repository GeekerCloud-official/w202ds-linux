			};
			i2c@2260000 {
				compatible = "sprd,qogirn6pro-i2c", "sprd,sc9860-i2c";
				reg = <0x2260000 0x100>;
				interrupts = <0x00 0xd6 0x04>;
				clock-frequency = <0x61a80>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
