		ch-ahb {
			time_sync_ch@62110080 {
				compatible = "sprd,time-sync-ch";
				reg = <0x00 0x62110080 0x00 0x10>;
				syscons = <0x02 0x124 0x01>;
				syscon-names = "ch_cfg_bus";
