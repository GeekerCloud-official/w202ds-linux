				reset-names = "i2c_rst";
				resets = <0x0d 0x06>;
				clock-names = "enable", "i2c", "source";
				clocks = <0x0d 0x09 0x08 0x07 0x09>;
				phandle = <0x147>;
			};
			i2c@2250000 {
				compatible = "sprd,qogirn6pro-i2c", "sprd,sc9860-i2c";
