				clocks = <0x0d 0x0b 0x08 0x09 0x09>;
				phandle = <0x14b>;
				pn544@29 {
					phandle = <0x259>;
					clocks = <0x11 0x6c 0x28 0x00 0x11 0x04>;
					clock-names = "bb_clk", "source", "enable";
					interrupt-names = "nfc_int";
					nxp,pn544-fw-dwnld = <0x0c 0xba 0x00>;
					nxp,pn544-ven = <0x0c 0x95 0x00>;
					nxp,pn544-clkreq = <0x0c 0x93 0x00>;
					nxp,pn544-irq = <0x0c 0x7f 0x00>;
					interrupts = <0x09 0x00>;
					interrupt-parent = <0x0c>;
