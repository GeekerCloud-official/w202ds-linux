				compatible = "sprd,djtag";
				status = "okay";
				reg = <0x570000 0x1000>;
				syscon = <0x02 0x130 0x8000>;
				clock-names = "enable", "tck";
				clocks = <0x11 0x02 0x11 0x53>;
				hwlocks = <0x69 0x0a>;
