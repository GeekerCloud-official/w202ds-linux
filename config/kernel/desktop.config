# Display/input foundation shared by desktop and debug.
# Optional drivers retain their current m selections; Devices/ builds external drivers.
# Normal boot uses bootloader arguments when supplied; provide a matching rootfs/initramfs.
# Audio is not enabled in the imported baseline.

CONFIG_BT=m
CONFIG_BT_RFCOMM=m
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=m
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
CONFIG_BT_HIDP=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_H4=y
CONFIG_RFKILL=y
CONFIG_INPUT_EVDEV=y
CONFIG_KEYBOARD_GPIO=y
# CONFIG_INPUT_MOUSE is not set
CONFIG_INPUT_MISC=y
CONFIG_INPUT_UINPUT=m
CONFIG_MEDIA_SUPPORT=m
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_USB_VIDEO_CLASS=m
CONFIG_DRM=y
CONFIG_DRM_PANFROST=m
CONFIG_FB=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
CONFIG_UHID=m
CONFIG_FONTS=y
CONFIG_FONT_8x8=y
CONFIG_FONT_TER16x32=y
# CONFIG_IKCONFIG is not set
# CONFIG_IKCONFIG_PROC is not set
# CONFIG_PM_DEBUG is not set
# CONFIG_PM_ADVANCED_DEBUG is not set
# CONFIG_PRINTK_TIME is not set
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_MAGIC_SYSRQ is not set
# CONFIG_DEBUG_FS is not set
# CONFIG_HARDLOCKUP_DETECTOR is not set
# CONFIG_SOFTLOCKUP_DETECTOR is not set
# CONFIG_PJ4EDK_BOOT_DISPLAY is not set
CONFIG_LOCALVERSION="-w202ds-desktop"
CONFIG_CMDLINE="console=tty1 loglevel=4 clk_ignore_unused pd_ignore_unused regulator_ignore_unused fw_devlink=permissive cma=64M@0x80000000-0x100000000 fbcon=rotate:1,font:VGA8x16"
# CONFIG_CMDLINE_FORCE is not set
CONFIG_CMDLINE_FROM_BOOTLOADER=y
# CONFIG_SOUND is not set
