# W202DS hardware selections and legacy debug image identity.
# Recovery control remains available in both profiles; its timer is profile-specific.
# Imported LED selections are retained; selection alone is not hardware validation.

CONFIG_LOCALVERSION="-w202ds"
CONFIG_DRM_W202DS_BRINGUP_HELPERS=y
CONFIG_W202DS_BACKLIGHT=y
CONFIG_USB_W202DS_DUMMY_PHY=y
CONFIG_LEDS_AW9523B=y
CONFIG_LEDS_ZTE_LDO=y
CONFIG_LEDS_SC27XX_KPLED=y
CONFIG_W202DS_DIAG_RECOVERY=y
CONFIG_CMA_SIZE_MBYTES=64
CONFIG_LOCALVERSION_AUTO=y
