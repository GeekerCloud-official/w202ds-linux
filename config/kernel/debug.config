# Debug inherits desktop; retain the former Server settings except legacy fbcon.
# Keep the legacy -w202ds release for this existing debug baseline.
# The command line requires matching diagnostic userspace.
# ftrace, KGDB, DWARF debug information and sanitizers are not enabled by this profile.

CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_PM_DEBUG=y
CONFIG_PM_ADVANCED_DEBUG=y
CONFIG_PRINTK_TIME=y
CONFIG_DEBUG_KERNEL=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_DEBUG_FS=y
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_PJ4EDK_BOOT_DISPLAY=y
CONFIG_LOCALVERSION="-w202ds"
CONFIG_CMDLINE="console=tty1 loglevel=7 systemd.show_status=1 systemd.log_target=kmsg log_buf_len=4M rdinit=/w202diag panic=10 clk_ignore_unused pd_ignore_unused regulator_ignore_unused fw_devlink=permissive w202ds_diag=M12 cma=64M@0x80000000-0x100000000 fbcon=rotate:1,font:VGA8x16"
CONFIG_CMDLINE_FORCE=y
# CONFIG_CMDLINE_FROM_BOOTLOADER is not set
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_FTRACE is not set
# CONFIG_KGDB is not set
# CONFIG_KASAN is not set
# CONFIG_KCSAN is not set
# CONFIG_UBSAN is not set
# CONFIG_DYNAMIC_DEBUG is not set
# CONFIG_PROVE_LOCKING is not set
