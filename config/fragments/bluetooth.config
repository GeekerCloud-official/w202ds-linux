# Bluetooth for SC2355 / Marlin3: sprdbt_tty (/dev/ttyBT0) + btattach H4 + BlueZ.
# hci_uart with the H4 protocol is the HCI transport; RFCOMM, BNEP and HIDP serve desktop profiles.
# USB Bluetooth drivers are not used by this controller.
CONFIG_RFKILL=y
CONFIG_BT=m
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=m
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=m
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
CONFIG_BT_HIDP=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_H4=y
